{
  "name": "innovatif-site",
  "version": "2.0.0",
  "private": true,
  "description": "Amazing Innovatif — print, websites, online booking and custom software for business.",
  "type": "module",
  "scripts": {
    "dev": "eleventy --serve --port 8080",
    "dev:designs": "vite --config designs/vite.config.ts",
    "build": "eleventy && npm run build:designs && npm run build:payments",
    "build:designs": "tsc -p designs/tsconfig.json && vite build --config designs/vite.config.ts",
    "build:payments": "node scripts/build-payments.mjs",
    "emulators": "npm run build && firebase emulators:start --project demo-innovatif",
    "test": "npm run test:payments && npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-innovatif \"node --test tests/firestore.rules.test.mjs\"",
    "test:payments": "node --test tests/payments.test.mjs",
    "test:e2e": "npm run build && node tests/run-e2e.mjs",
    "images": "node scripts/optimize-images.mjs",
    "icons": "node scripts/build-icons.mjs",
    "deploy": "firebase deploy",
    "deploy:site": "firebase deploy --only hosting,firestore"
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.8",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@phosphor-icons/core": "^2.1.1",
    "@types/node": "^22.20.7",
    "@types/react": "^19.3.3",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "esbuild": "^0.28.2",
    "firebase": "^13.4.0",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^7.4.0",
    "firebase-tools": "^15.37.0",
    "jose": "^6.2.18",
    "playwright": "^1.63.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.7",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3",
    "vite": "^7.3.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
