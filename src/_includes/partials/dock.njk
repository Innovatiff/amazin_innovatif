{% import "ui.njk" as ui %}
{# Always-reachable contact buttons: a bar on phones, a floating button on desktop. #}
{% if dock %}
<aside class="dock" data-dock aria-label="Contact shortcuts">
  {% if site.phone -%}
  <a class="dock__item" href="{{ site.phone | tel }}">{{ ui.icon('phone-fill') }}<span>Call</span></a>
  {%- endif %}
  {% if site.whatsapp -%}
  <a class="dock__item dock__item--whatsapp" href="{{ site.whatsapp | whatsapp('Hi ' + site.name + '! I’d like to ask about your services.') }}" target="_blank" rel="noopener">{{ ui.icon('whatsapp-logo-fill') }}<span>WhatsApp</span></a>
  {%- endif %}
  {% if dockMessage -%}
  <button class="dock__item dock__item--message" type="button" data-quote>{{ ui.icon('chat-circle-text-fill') }}<span>{% if site.phone or site.whatsapp %}Message{% else %}Get a free quote{% endif %}</span></button>
  {%- endif %}
</aside>
{% endif %}
