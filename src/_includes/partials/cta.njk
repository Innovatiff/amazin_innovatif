{% import "ui.njk" as ui %}
{#
  The closing section of a page: one big line, one action.
  Set ctaTitle (may contain <span class="grad">…</span>), ctaText, ctaService
  and ctaLabel before including. `backdrop` comes from the page's front matter.
#}
<section class="section cta">
  <div class="backdrop backdrop--{{ backdrop or 'aurora' }}" aria-hidden="true"></div>
  <div class="container">
    <div class="cta__inner">
      <h2>{{ ctaTitle | safe }}</h2>
      <p class="lead">{{ ctaText }}</p>
      {{ ui.contact(site, service=ctaService, label=(ctaLabel or 'Get a free quote'), size='lg') }}
      <p class="note">Free quote · No obligation{% if not site.phone and not site.whatsapp %} · Leave your number and we’ll call you back{% endif %}</p>
    </div>
  </div>
</section>
