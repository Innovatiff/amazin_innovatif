---
layout: layouts/base.njk
permalink: /get-started.html
key: get-started
accent: booking
backdrop: calendar
pageScript: /assets/js/booking-form.js
title: Get your booking system — Innovatif
description: Tell us about your business and reserve your spot. We only accept one business per category per town.
---
{% import "ui.njk" as ui %}

<section class="page-hero">
  <div class="backdrop backdrop--calendar" aria-hidden="true"></div>
  <div class="container">
    <div class="page-hero__text">
      {{ ui.eyebrow('Booking system', '📅') }}
      <h1>Let’s build your <span class="grad">booking system.</span></h1>
      <p class="lead">Five quick steps, about two minutes. We’ll check availability for your category and town.</p>
    </div>
  </div>
</section>

<section class="section section--tight section--flush-top">
  <div class="container">
    <form class="wizard panel" data-booking-form novalidate>
      <div class="wizard__progress" aria-hidden="true"><span></span><span></span><span></span><span></span><span></span></div>
      <p class="sr-only" aria-live="polite" data-step-label></p>

      <fieldset class="wizard__step" data-step="1">
        <legend class="sr-only">About you</legend>
        <h2>First, who are we talking to?</h2>
        <div class="field">
          <label for="b-fullName">Your name</label>
          <input id="b-fullName" name="fullName" type="text" autocomplete="name" maxlength="100" required>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="b-phone">Phone number</label>
            <input id="b-phone" name="phone" type="tel" autocomplete="tel" inputmode="tel" maxlength="40" required>
          </div>
          <div class="field">
            <label for="b-email">Email address</label>
            <input id="b-email" name="email" type="email" autocomplete="email" maxlength="200" required>
          </div>
        </div>
        <p class="field-hint">We’ll use these to contact you about your booking system and send your next steps.</p>
      </fieldset>

      <fieldset class="wizard__step" data-step="2" hidden>
        <legend class="sr-only">Your business</legend>
        <h2>Tell us about your business</h2>
        <div class="field">
          <label for="b-businessName">Business name</label>
          <input id="b-businessName" name="businessName" type="text" autocomplete="organization" maxlength="120" required>
        </div>
        <div class="field-row">
          <div class="field">
            <label for="b-businessType">Type of business</label>
            <select id="b-businessType" name="businessType" required>
              <option value="">Choose one</option>
              {% for type in plans.bookingForm.businessTypes %}<option>{{ type }}</option>{% endfor %}
            </select>
          </div>
          <div class="field" data-other-type hidden>
            <label for="b-businessTypeSpecific">What kind?</label>
            <input id="b-businessTypeSpecific" name="businessTypeSpecific" type="text" maxlength="80">
          </div>
          <div class="field">
            <label for="b-city">Town or city you serve</label>
            <input id="b-city" name="city" type="text" autocomplete="address-level2" maxlength="80" required>
          </div>
        </div>
        <p class="field-hint">Your town helps us check category availability in your area.</p>
        <fieldset class="field">
          <legend class="field-legend">Do you already have a website?</legend>
          <div class="options options--2">
            {% for answer in plans.bookingForm.websiteStatus -%}
            <label class="option"><input type="radio" name="websiteStatus" value="{{ answer }}" required><span class="option__box"><strong>{{ answer }}</strong></span></label>
            {%- endfor %}
          </div>
        </fieldset>
      </fieldset>

      <fieldset class="wizard__step" data-step="3" hidden>
        <legend class="sr-only">Plan</legend>
        <h2>Which plan are you interested in?</h2>
        <div class="options">
          {% for plan in plans.booking -%}
          <label class="option"><input type="radio" name="plan" value="{{ plan.name }}" required><span class="option__box"><strong>{{ plan.name }}</strong><small>{{ plan.setup }} setup + {{ plan.price }}{{ plan.period }}</small><span>{{ plan.tagline }}. {{ plan.bestFor }}</span></span></label>
          {%- endfor %}
          <label class="option"><input type="radio" name="plan" value="Not sure" required><span class="option__box"><strong>Not sure</strong><small>Help me choose</small><span>We’ll contact you and help you choose the plan that fits.</span></span></label>
        </div>
      </fieldset>

      <fieldset class="wizard__step" data-step="4" hidden>
        <legend class="sr-only">Goals</legend>
        <h2>What matters most right now?</h2>
        <fieldset class="field">
          <legend class="field-legend">Your main goals <span class="optional">choose any</span></legend>
          <div class="options options--2">
            {% for goal in plans.bookingForm.goals -%}
            <label class="option"><input type="checkbox" name="mainGoal" value="{{ goal }}"><span class="option__box"><strong>{{ goal }}</strong></span></label>
            {%- endfor %}
          </div>
        </fieldset>
        <fieldset class="field">
          <legend class="field-legend">Your biggest problems with bookings <span class="optional">choose any</span></legend>
          <div class="options options--2">
            {% for problem in plans.bookingForm.problems -%}
            <label class="option"><input type="checkbox" name="bookingProblem" value="{{ problem }}"><span class="option__box"><strong>{{ problem }}</strong></span></label>
            {%- endfor %}
          </div>
        </fieldset>
      </fieldset>

      <fieldset class="wizard__step" data-step="5" hidden>
        <legend class="sr-only">Reserve your spot</legend>
        <h2>Ready to reserve your spot?</h2>
        <p>We only accept one business per category per town. Your deposit reserves your spot and goes toward your setup fee.</p>
        <div class="options">
          <label class="option"><input type="radio" name="reservationChoice" value="Reserve my spot" required><span class="option__box"><strong>Reserve my spot</strong><small>{{ site.depositAmount }} deposit</small><span>Reserve your category spot and start your booking system setup. You’ll be taken to our secure payment page.</span></span></label>
          <label class="option"><input type="radio" name="reservationChoice" value="Not yet" required><span class="option__box"><strong>Not yet</strong><small>I want to talk first</small><span>Send your details and we’ll contact you with the next steps.</span></span></label>
        </div>
      </fieldset>

      <div class="field-trap" aria-hidden="true">
        <label for="b-website">Leave this empty</label>
        <input id="b-website" name="website" type="text" tabindex="-1" autocomplete="off">
      </div>

      <p class="form-status" role="alert" data-form-status hidden></p>

      <div class="wizard__nav" data-wizard-nav>
        <button class="btn btn--outline" type="button" data-back hidden>{{ ui.icon('arrow-left') }}<span>Back</span></button>
        <span></span>
        <button class="btn btn--accent" type="submit" data-next><span data-next-label>Next</span>{{ ui.icon('arrow-right') }}</button>
      </div>

      <div class="lead-form__done" data-form-done hidden tabindex="-1">
        <div class="lead-form__tick">{{ ui.icon('check') }}</div>
        <h2>Thank you. We received your request.</h2>
        <p>We’ll review your business, check availability in your category and town, and contact you with the next steps.</p>
        <a class="btn btn--outline" href="/booking">Back to the booking system</a>
      </div>
    </form>
  </div>
</section>
