---
layout: layouts/base.njk
permalink: /index.html
key: home
accent: neutral
backdrop: aurora
title: Printing, websites, booking systems and software for business
eleventyComputed:
  description: "{{ site.name }} is the all-in-one agency for local businesses — marketing print, websites from $49.99/month, online booking systems and custom software, handled by one team."
---
{% import "ui.njk" as ui %}

{# ── 1. The promise: what you get, in three beats ───────────────────────── #}
<section class="hero">
  <div class="backdrop backdrop--aurora" aria-hidden="true"></div>
  <div class="container hero__content">
    <p class="eyebrow">The all-in-one agency for local business</p>
    <h1>
      <span class="grad" data-accent="print">Get noticed.</span>
      <span class="grad" data-accent="booking">Get booked.</span>
      <span class="grad" data-accent="software">Get paid.</span>
    </h1>
    <p class="lead">Printing, websites, online booking and custom software. Everything your business needs to grow — made by one team.</p>
    {{ ui.contact(site, size='lg') }}
    <p class="note">Free quote · No obligation</p>
  </div>

  <div class="marquee" role="group" aria-label="A sample of what we make" tabindex="0">
    {% for row in home.marquee %}
    <div class="marquee__row{% if loop.index == 2 %} marquee__row--reverse{% endif %}">
      {% for copy in [0, 1] %}
      <div class="marquee__set"{% if copy == 1 %} aria-hidden="true"{% endif %}>
        {% for item in row -%}
        <figure class="marquee__tile">
          <img src="/assets/img/{{ item[0] }}-640.webp" alt="{% if copy == 0 %}{{ item[1] }}{% endif %}" width="640" height="478" decoding="async" fetchpriority="low">
          <span>{{ item[1] }}</span>
        </figure>
        {%- endfor %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</section>

{# ── 2. Four doors: pick what you came for ──────────────────────────────── #}
<section class="section section--tight" id="services">
  <div class="container">
    <h2 class="sr-only">What we do</h2>
    <div class="doors">
      {% for door in home.doors -%}
      <a class="door" data-accent="{{ door.accent }}" href="{{ door.href }}">
        {{ ui.emoji(door.emoji) }}
        <span class="door__big grad">{{ door.big }}</span>
        <span class="door__label">{{ door.label }}</span>
        <span class="more">{{ door.link }}{{ ui.icon('caret-right') }}</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

{# ── 3. Printing ────────────────────────────────────────────────────────── #}
<section class="section" id="print" data-accent="print">
  <div class="backdrop backdrop--halftone" aria-hidden="true"></div>
  <div class="container">
    <header class="section-head">
      {{ ui.eyebrow('Printing & marketing', '🖨️') }}
      <h2>If it carries your brand, <span class="grad">we print it.</span></h2>
      <p class="lead">Business cards to vehicle wraps — {{ print.total }} products, designed and printed for you. No price lists: tell us what you need and get a quote.</p>
      <div class="actions">
        <button class="btn btn--accent" type="button" data-quote data-service="Printing">Get a print quote</button>
        {{ ui.more('/printing', 'See everything we print') }}
      </div>
    </header>

    <div class="mosaic">
      {% for id in home.mosaic -%}
      <a class="tile" href="/printing#{{ id }}">
        {{ ui.img('print/' + id, '', '(min-width: 860px) 50vw, 94vw' if (loop.index == 1 or loop.index == 6) else '(min-width: 860px) 25vw, 48vw') }}
        <span class="tile__label">{{ print.byId[id].name }}</span>
      </a>
      {%- endfor %}
    </div>
  </div>

  <div class="ticker" aria-hidden="true">
    <div class="ticker__row">
      {% for copy in [0, 1] %}
      <div class="ticker__set">{% for name in print.ticker %}<span>{{ name }}</span>{% endfor %}</div>
      {% endfor %}
    </div>
  </div>
</section>

{# ── 4. Websites ────────────────────────────────────────────────────────── #}
<section class="section" id="websites" data-accent="web">
  <div class="backdrop backdrop--grid" aria-hidden="true"></div>
  <div class="container">
    <header class="section-head">
      {{ ui.eyebrow('Websites', '🌐') }}
      <h2>A website that makes <span class="grad">the phone ring.</span></h2>
      <p class="lead">Designed for you, built for phones, hosted and looked after by us. Two simple plans.</p>
    </header>

    <div class="page-hero__media">
      {{ ui.wide('web-hero', 'One website shown on a monitor, laptop, tablet and phone', '(min-width: 1240px) 1200px, 94vw', false) }}
    </div>

    <div class="mini-plans">
      {% for plan in plans.websites -%}
      <a class="mini-plan{% if plan.best %} mini-plan--best{% endif %}" href="/websites#plans">
        <span class="mini-plan__name">{{ plan.name }}{% if plan.best %} · Best offer{% endif %}</span>
        <span class="mini-plan__price">{{ plan.price }}<small> {{ plan.period }}</small></span>
        <span class="mini-plan__text">{{ plan.tagline }}. {{ plan.ready }}.</span>
        <span class="more">See what’s included{{ ui.icon('caret-right') }}</span>
      </a>
      {%- endfor %}
    </div>
  </div>
</section>

{# ── 5. Booking system ──────────────────────────────────────────────────── #}
<section class="section" id="booking" data-accent="booking">
  <div class="backdrop backdrop--calendar" aria-hidden="true"></div>
  <div class="container split split--reverse">
    <div class="split__text">
      {{ ui.eyebrow('Booking system', '📅') }}
      <h2>Stop losing customers <span class="grad">in your DMs.</span></h2>
      <p class="lead">One link where customers see your services and prices — and book you from their phone.</p>
      <ul class="ticks">
        <li>{{ ui.icon('check') }}<span>Website, booking form and automatic confirmation emails</span></li>
        <li>{{ ui.icon('check') }}<span>A dashboard and stats page you check from your phone</span></li>
        <li>{{ ui.icon('check') }}<span>From <strong>{{ plans.booking[0].price }} a month</strong>, plus a one-time setup</span></li>
      </ul>
      <div class="guarantee">
        {{ ui.emojiTile('⏱️') }}
        <span><strong>Ready in 7 days</strong><span>…or your first month is free.</span></span>
      </div>
      <div class="actions">
        <a class="btn btn--accent" href="/booking">See the booking system</a>
        {{ ui.more('/booking#pricing', 'See pricing') }}
      </div>
    </div>
    <div class="split__media">
      {{ ui.img('booking/booking-phone', 'A customer booking an appointment on their phone', '(min-width: 900px) 46vw, 94vw') }}
    </div>
  </div>
</section>

{# ── 6. Software ────────────────────────────────────────────────────────── #}
<section class="section" id="software" data-accent="software">
  <div class="backdrop backdrop--lines" aria-hidden="true"></div>
  <div class="container">
    <header class="section-head">
      {{ ui.eyebrow('Custom software', '⚙️') }}
      <h2>Software that <span class="grad">runs your day.</span></h2>
      <p class="lead">A POS that handles 100,000+ products. Restaurant ordering. An AI receptionist that never misses a call. Or something built only for you.</p>
      <div class="actions">
        <button class="btn btn--accent" type="button" data-quote data-service="Software">Ask for pricing</button>
        {{ ui.more('/software', 'Explore all software') }}
      </div>
    </header>

    <div class="bento">
      {% for item in software.flagship -%}
      <a class="bento__tile{% if loop.index <= 2 %} bento__tile--wide{% endif %}" href="/software#{{ item.id }}">
        <div class="bento__media">{{ ui.img('software/' + item.id, '', '(min-width: 1000px) 50vw, 94vw' if loop.index <= 2 else '(min-width: 1000px) 25vw, 46vw') }}</div>
        <div class="bento__body">
          {{ ui.emoji(item.emoji) }}
          <h3>{{ item.short }}</h3>
          <p>{{ item.lead }}</p>
        </div>
      </a>
      {%- endfor %}
    </div>
    <p class="fineprint">Every system is priced per project — call or message us for a clear quote.</p>
  </div>
</section>

{# ── 7. Why one team ────────────────────────────────────────────────────── #}
<section class="section" id="why">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Why {{ site.name }}</p>
      <h2><span class="nb">One team.</span> <span class="nb">One look.</span> <span class="grad nb">One call.</span></h2>
      <p class="lead">Most businesses juggle a printer, a web designer and a software company. With us it’s one conversation — and everything matches.</p>
    </header>
    <div class="grid grid--3">
      {% for item in home.why -%}
      <div class="card" data-accent="{{ ['print', 'software', 'booking'][loop.index0] }}">
        {{ ui.emojiTile(item.emoji) }}
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

{# ── 8. How it works ────────────────────────────────────────────────────── #}
<section class="section section--flush-top" id="how" data-accent="web">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">How it works</p>
      <h2>Three steps. <span class="grad">That’s it.</span></h2>
    </header>
    <ol class="steps steps--3">
      {% for step in home.steps -%}
      <li class="step">
        <div class="step__media">{{ ui.img(step.image, step.alt) }}</div>
        <div class="step__body"><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

{# ── 9. Questions ───────────────────────────────────────────────────────── #}
<section class="section section--flush-top" id="faq">
  <div class="container">
    <header class="section-head">
      <h2>Questions? <span class="grad">Answered.</span></h2>
    </header>
    {{ ui.faqs(home.faqs, true) }}
  </div>
</section>

{% set ctaTitle = 'Make your business <span class="grad" data-accent="print">impossible to miss.</span>' %}
{% set ctaText = 'Tell us what you need and we’ll take it from there.' %}
{% include "partials/cta.njk" %}
