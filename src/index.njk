---
layout: layouts/base.njk
permalink: /index.html
key: home
accent: neutral
title: Innovatif — Printing, websites, booking systems and software for business
description: Innovatif is the all-in-one agency for local businesses — marketing print, websites from $49.99/month, online booking systems and custom software, handled by one team.
---
{% import "ui.njk" as ui %}

<section class="hero">
  <div class="hero__grid" aria-hidden="true"></div>
  <div class="container hero__content">
    {{ ui.eyebrow('The all-in-one agency for business', 'sparkle-fill') }}
    <h1><span>Print it.</span> <span>Launch it.</span> <span class="muted">Run it.</span></h1>
    <p class="lead">Marketing print, websites, online booking and custom software — designed, built and looked after by one team, so your business looks sharp everywhere customers find you.</p>
    {{ ui.contact(site, label='Get a free quote') }}
    <ul class="hero__services" aria-label="What we do">
      <li><a class="hero__service" data-accent="print" href="/printing">{{ ui.icon('printer') }}Printing</a></li>
      <li><a class="hero__service" data-accent="web" href="/websites">{{ ui.icon('browser') }}Websites</a></li>
      <li><a class="hero__service" data-accent="booking" href="/booking">{{ ui.icon('calendar-check') }}Booking system</a></li>
      <li><a class="hero__service" data-accent="software" href="/software">{{ ui.icon('code') }}Software</a></li>
    </ul>
  </div>

  <div class="marquee" role="group" aria-label="A sample of what we make" tabindex="0">
    {% for row in home.marquee %}
    <div class="marquee__row{% if loop.index == 2 %} marquee__row--reverse{% endif %}">
      {% for copy in [0, 1] %}
      <div class="marquee__set"{% if copy == 1 %} aria-hidden="true"{% endif %}>
        {% for item in row -%}
        <figure class="marquee__tile">
          <img src="/assets/img/{{ item[0] }}-640.webp" alt="{% if copy == 0 %}{{ item[1] }}{% endif %}" width="640" height="478" decoding="async" fetchpriority="low">
          <span>{{ item[1] }}</span>
        </figure>
        {%- endfor %}
      </div>
      {% endfor %}
    </div>
    {% endfor %}
  </div>
</section>

<section class="section" id="services">
  <div class="container">
    <header class="section-head">
      {{ ui.eyebrow('What we do', 'squares-four') }}
      <h2>Four ways we help your business grow</h2>
      <p class="lead">Most businesses juggle a printer, a web designer and a software company. With Innovatif it’s one conversation — and everything matches.</p>
    </header>

    <div class="pillars">
      <a class="pillar" data-accent="print" href="/printing">
        <div class="pillar__media">{{ ui.wide('print-hero', 'A full set of matching printed brand materials', '(min-width: 760px) 48vw, 94vw', false) }}</div>
        <div class="pillar__body">
          {{ ui.eyebrow('Printing & marketing', 'printer') }}
          <h3>Everything printed, from business cards to vehicle wraps</h3>
          <p>Cards, flyers, posters, banners, shirts, stickers, labels, vinyl, signs, packaging and promo products — designed and printed for you.</p>
          <p class="pillar__price">Every job quoted to fit · <strong>call or message</strong></p>
          <span class="text-link">Browse print products {{ ui.icon('arrow-right') }}</span>
        </div>
      </a>

      <a class="pillar" data-accent="web" href="/websites">
        <div class="pillar__media">{{ ui.wide('web-hero', 'One website shown on a monitor, laptop, tablet and phone', '(min-width: 760px) 48vw, 94vw', false) }}</div>
        <div class="pillar__body">
          {{ ui.eyebrow('Websites', 'browser') }}
          <h3>A professional website, live in days</h3>
          <p>Fast, mobile-friendly sites that look the part and make it easy for customers to call, message or book.</p>
          <p class="pillar__price">Plans at <strong>{{ plans.websites[0].price }}</strong> and <strong>{{ plans.websites[1].price }}</strong> {{ plans.websites[0].period }}</p>
          <span class="text-link">See website plans {{ ui.icon('arrow-right') }}</span>
        </div>
      </a>

      <a class="pillar" data-accent="booking" href="/booking">
        <div class="pillar__media">{{ ui.img('booking/booking-phone', 'A customer booking an appointment on their phone', '(min-width: 760px) 48vw, 94vw') }}</div>
        <div class="pillar__body">
          {{ ui.eyebrow('Booking system', 'calendar-check') }}
          <h3>Turn visitors into booked appointments</h3>
          <p>A website, booking form, confirmation emails and a dashboard on your phone — ready in 7 days.</p>
          <p class="pillar__price">From <strong>{{ plans.booking[0].price }}</strong> {{ plans.booking[0].period }}</p>
          <span class="text-link">How the booking system works {{ ui.icon('arrow-right') }}</span>
        </div>
      </a>

      <a class="pillar" data-accent="software" href="/software">
        <div class="pillar__media">{{ ui.wide('software-hero', 'Business software running on a POS terminal, tablet, laptop and phone', '(min-width: 760px) 48vw, 94vw', false) }}</div>
        <div class="pillar__body">
          {{ ui.eyebrow('Custom software', 'code') }}
          <h3>Software built around how you work</h3>
          <p>Advanced POS, restaurant ordering, AI receptionists, inventory, staff management and anything else you need built.</p>
          <p class="pillar__price">Priced per project · <strong>call or message</strong></p>
          <span class="text-link">Explore software {{ ui.icon('arrow-right') }}</span>
        </div>
      </a>
    </div>
  </div>
</section>

<section class="section section--soft" id="print" data-accent="print">
  <div class="container">
    <header class="section-head section-head--split">
      {{ ui.eyebrow('Printing & marketing', 'printer') }}
      <h2>If it carries your brand, we print it</h2>
      <p class="lead">{{ print.categories | length }} product families and well over a hundred products. No price lists to decode — tell us what you need and we’ll quote it.</p>
      <a class="btn btn--outline section-head__aside" href="/printing">See everything we print {{ ui.icon('arrow-right') }}</a>
    </header>

    <div class="mosaic">
      {% for id in home.mosaic -%}
      <a class="tile" href="/printing#{{ id }}">
        {{ ui.img('print/' + id, '', '(min-width: 860px) 50vw, 94vw' if (loop.index == 1 or loop.index == 6) else '(min-width: 860px) 25vw, 48vw') }}
        <span class="tile__label">{{ print.byId[id].name }} {{ ui.icon('arrow-up-right') }}</span>
      </a>
      {%- endfor %}
    </div>

    <ul class="chips chips--lg chips--links" aria-label="Print categories">
      {% for category in print.categories -%}
      <li><a href="/printing#{{ category.id }}">{{ category.short }}</a></li>
      {%- endfor %}
    </ul>
  </div>
</section>

<section class="section" id="websites" data-accent="web">
  <div class="container split">
    <div class="split__text">
      {{ ui.eyebrow('Websites', 'browser') }}
      <h2>A website that makes people pick up the phone</h2>
      <p class="lead">Two simple plans. Both are designed for you, look great on every screen and are hosted and looked after by us.</p>
      <div class="mini-plans">
        {% for plan in plans.websites -%}
        <a class="mini-plan{% if plan.best %} mini-plan--best{% endif %}" href="/websites#plans">
          <span class="mini-plan__name">{% if plan.best %}{{ plan.name }} · Best offer{% else %}{{ plan.name }}{% endif %}</span>
          <span class="mini-plan__price">{{ plan.price }}<small>{{ plan.period }}</small></span>
          <span class="mini-plan__text">{{ plan.tagline }}</span>
        </a>
        {%- endfor %}
      </div>
      <a class="text-link" href="/websites">Compare the website plans {{ ui.icon('arrow-right') }}</a>
    </div>
    <div class="split__media">
      {{ ui.img('web/flower-shop', 'A flower shop website on a laptop and phone', '(min-width: 900px) 46vw, 94vw') }}
    </div>
  </div>
</section>

<section class="section section--soft" id="booking" data-accent="booking">
  <div class="container split split--reverse">
    <div class="split__text">
      {{ ui.eyebrow('7-day booking system', 'calendar-check') }}
      <h2>Stop losing customers in your DMs</h2>
      <p class="lead">Give customers one link where they can see your services and prices, trust your business and book from their phone.</p>
      <ul class="ticks">
        <li>{{ ui.icon('check') }}<span>Website, booking form and automatic confirmation emails</span></li>
        <li>{{ ui.icon('check') }}<span>A dashboard and stats page you can check from your phone</span></li>
        <li>{{ ui.icon('check') }}<span>Ready in 7 days — or your first month is free</span></li>
      </ul>
      <div class="actions">
        <a class="btn btn--accent" href="/booking">See the booking system {{ ui.icon('arrow-right') }}</a>
        <a class="btn btn--outline" href="/booking#pricing">From {{ plans.booking[0].price }}{{ plans.booking[0].period }}</a>
      </div>
    </div>
    <div class="split__media">
      {{ ui.img('booking/dashboard', 'A bookings dashboard on a laptop', '(min-width: 900px) 46vw, 94vw') }}
    </div>
  </div>
</section>

<section class="section" id="software" data-accent="software">
  <div class="container">
    <header class="section-head section-head--split">
      {{ ui.eyebrow('Custom software', 'code') }}
      <h2>The systems that run your day</h2>
      <p class="lead">From a POS that handles 100,000+ products to an AI receptionist that never misses a call — built for your business, not adapted from someone else’s.</p>
      <a class="btn btn--outline section-head__aside" href="/software">All software {{ ui.icon('arrow-right') }}</a>
    </header>

    <div class="grid grid--3">
      {% for item in software.flagship -%}
      <a class="shot" href="/software#{{ item.id }}">
        <div class="shot__media">{{ ui.img('software/' + item.id, item.name) }}</div>
        <div class="shot__body">
          <h3>{{ ui.icon(item.icon) }}{{ item.name }}</h3>
          <p>{{ item.lead }}</p>
        </div>
      </a>
      {%- endfor %}
    </div>
    <p class="fineprint">All software is priced per project — call or message us and we’ll give you a clear quote.</p>
  </div>
</section>

<section class="section section--soft" id="how">
  <div class="container">
    <header class="section-head section-head--center">
      {{ ui.eyebrow('How it works', 'lightning') }}
      <h2>Simple from the first message</h2>
    </header>
    <ol class="steps steps--3">
      <li class="step">
        <div class="step__media">{{ ui.img('general/chat-support', 'A customer asking for a quote by message') }}</div>
        <div class="step__body"><h3>Tell us what you need</h3><p>Call, WhatsApp or send a message. A rough idea is enough — we’ll ask the right questions.</p></div>
      </li>
      <li class="step">
        <div class="step__media">{{ ui.img('general/design-studio', 'A designer working on a brand identity') }}</div>
        <div class="step__body"><h3>We design and build it</h3><p>You get a clear quote, then a proof or preview to approve before anything is final.</p></div>
      </li>
      <li class="step">
        <div class="step__media">{{ ui.img('general/order-pickup', 'A finished order being handed to a customer') }}</div>
        <div class="step__body"><h3>Finished and looked after</h3><p>Collect your order or watch your site go live — and we’re still here when you need changes.</p></div>
      </li>
    </ol>
  </div>
</section>

<section class="section" id="why">
  <div class="container">
    <header class="section-head">
      {{ ui.eyebrow('Why Innovatif', 'handshake') }}
      <h2>One team. One look. One number to call.</h2>
    </header>
    <div class="grid grid--3">
      {% for item in home.why -%}
      <div class="card">
        <span class="card__icon">{{ ui.icon(item.icon) }}</span>
        <h3>{{ item.title }}</h3>
        <p>{{ item.text }}</p>
      </div>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section section--soft" id="faq">
  <div class="container">
    <header class="section-head section-head--center">
      {{ ui.eyebrow('Questions', 'question') }}
      <h2>Good to know</h2>
    </header>
    {{ ui.faqs(home.faqs, true) }}
  </div>
</section>

{% set ctaTitle = 'Tell us what your business needs' %}
{% include "partials/cta.njk" %}
