---
layout: layouts/base.njk
permalink: /printing.html
key: printing
accent: print
backdrop: halftone
shareImage: print-hero
title: Printing & marketing materials — business cards, banners, shirts, stickers
eleventyComputed:
  description: "Business cards, flyers, posters, banners, signs, vehicle wraps, shirts, stickers, labels, vinyl, packaging and promo products. Designed and printed by {{ site.name }} — call, WhatsApp or message for a quote."
---
{% import "ui.njk" as ui %}

<section class="page-hero">
  <div class="backdrop backdrop--halftone" aria-hidden="true"></div>
  <div class="container">
    <div class="page-hero__text">
      {{ ui.eyebrow('Printing & marketing', '🖨️') }}
      <h1>Print that gets you <span class="grad">noticed.</span></h1>
      <p class="lead">Business cards, banners, shirts, stickers, signs, packaging — {{ print.total }} products, designed and printed for you.</p>
      {{ ui.contact(site, service='Printing', label='Get a print quote', size='lg') }}
      <p class="page-hero__note">No price lists here. Every job is quoted to fit your size, quantity and finish — the answer is one message away.</p>
    </div>
    <div class="page-hero__media">
      {{ ui.wide('print-hero', 'A matching set of printed brand materials: cards, letterhead, flyer, stickers, shirt, tote bag, cups, mug and packaging') }}
    </div>
  </div>
</section>

<nav class="cat-nav" aria-label="Print categories">
  <div class="container">
    <ul class="cat-nav__list">
      {% for category in print.categories -%}
      <li><a class="cat-nav__link" href="#{{ category.id }}">{{ ui.emoji(category.emoji) }}{{ category.short }}</a></li>
      {%- endfor %}
    </ul>
  </div>
</nav>

<div class="container">
  {% for category in print.categories %}
  <section class="category" id="{{ category.id }}" aria-labelledby="{{ category.id }}-title">
    <header class="category__head">
      {{ ui.emojiTile(category.emoji, 'lg') }}
      <h2 id="{{ category.id }}-title">{{ category.title }}</h2>
      <p class="lead">{{ category.intro }}</p>
    </header>

    <div class="products">
      {% for product in category.products -%}
      <article class="product" id="{{ product.id }}">
        <div class="product__media">{{ ui.img('print/' + product.id, product.name + ' printed by ' + site.name, '(min-width: 1000px) 380px, 46vw') }}</div>
        <div class="product__body">
          <h3>{{ product.name }}</h3>
          <p>{{ product.text }}</p>
          <p class="product__options">{{ product.options | join(' · ') }}</p>
          <div class="product__actions">
            <button class="more" type="button" data-quote data-service="Printing" data-product="{{ product.name }}">Get a quote{{ ui.icon('caret-right') }}</button>
            {% if site.whatsapp -%}
            <a class="more more--whatsapp" href="{{ site.whatsapp | whatsapp('Hi ' + site.name + '! I’d like a quote for ' + product.name + '.') }}" target="_blank" rel="noopener" aria-label="Ask about {{ product.name }} on WhatsApp">WhatsApp{{ ui.icon('caret-right') }}</a>
            {%- endif %}
          </div>
        </div>
      </article>
      {%- endfor %}
    </div>

    <div class="also">
      <h3>We also print</h3>
      <ul class="names">
        {% for item in category.more %}<li>{{ item }}</li>
        {% endfor %}
      </ul>
      <button class="more" type="button" data-quote data-service="Printing">Something else? Just ask{{ ui.icon('caret-right') }}</button>
    </div>
  </section>
  {% endfor %}
</div>

<section class="section" id="design">
  <div class="backdrop backdrop--halftone" aria-hidden="true"></div>
  <div class="container split">
    <div class="split__text">
      {{ ui.eyebrow('Design service', '✏️') }}
      <h2>No design? <span class="grad">No problem.</span></h2>
      <p class="lead">Bring a logo, a sketch, a photo or just an idea. We design it properly, show you a proof and only print once you’re happy.</p>
      <ul class="ticks">
        <li>{{ ui.icon('check') }}<span>Logos and full brand identities</span></li>
        <li>{{ ui.icon('check') }}<span>Flyers, menus, signs, shirts and packaging artwork</span></li>
        <li>{{ ui.icon('check') }}<span>Old or blurry logo? We redraw it so it prints sharp at any size</span></li>
        <li>{{ ui.icon('check') }}<span>One look across your print, website and software</span></li>
      </ul>
      {{ ui.contact(site, service='Design', label='Ask about design') }}
    </div>
    <div class="split__media">
      {{ ui.img('general/design-studio', 'A designer working on a logo and brand identity', '(min-width: 900px) 46vw, 94vw') }}
    </div>
  </div>
</section>

<section class="section section--flush-top" id="how-its-made">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">How it’s made</p>
      <h2>The right method <span class="grad">for every job.</span></h2>
      <p class="lead">Different products need different processes. We pick the one that gives your job the best result for its quantity, material and budget.</p>
    </header>
    <div class="gallery gallery--three">
      <figure>{{ ui.img('general/large-format-printer', 'A wide-format printer producing a colorful banner', '(min-width: 760px) 32vw, 94vw') }}<figcaption>Large-format printing</figcaption></figure>
      <figure>{{ ui.img('general/screen-printing', 'Screen printing a design onto a black t-shirt', '(min-width: 760px) 32vw, 46vw') }}<figcaption>Screen printing &amp; transfers</figcaption></figure>
      <figure>{{ ui.img('general/embroidery', 'An embroidery machine stitching a logo onto a cap', '(min-width: 760px) 32vw, 46vw') }}<figcaption>Embroidery</figcaption></figure>
    </div>
  </div>
</section>

<section class="section section--flush-top" id="process">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">Ordering</p>
      <h2>From idea <span class="grad">to in your hands.</span></h2>
    </header>
    <ol class="steps steps--4">
      {% for step in print.steps -%}
      <li class="step">
        <div class="step__media">{{ ui.img(step.image, '', '(min-width: 1000px) 280px, 46vw') }}</div>
        <div class="step__body"><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div>
      </li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section section--flush-top" id="faq">
  <div class="container">
    <header class="section-head">
      <h2>Printing questions, <span class="grad">answered.</span></h2>
    </header>
    {{ ui.faqs(print.faqs, true) }}
  </div>
</section>

{% set ctaTitle = 'Tell us what you want <span class="grad">printed.</span>' %}
{% set ctaText = 'Send the product, quantity and deadline — or just describe the idea — and we’ll reply with a quote.' %}
{% set ctaService = 'Printing' %}
{% set ctaLabel = 'Get a print quote' %}
{% include "partials/cta.njk" %}
