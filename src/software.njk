---
layout: layouts/base.njk
permalink: /software.html
key: software
accent: software
shareImage: software-hero
title: Custom business software — POS, restaurant ordering, AI receptionist, inventory | Innovatif
description: Tailored software for business — an advanced POS for 100,000+ products, restaurant ordering systems, AI receptionists, employee management, inventory and fully custom builds. Call or message for pricing.
---
{% import "ui.njk" as ui %}

<section class="page-hero">
  <div class="container">
    <div class="page-hero__text">
      {{ ui.eyebrow('Tailored software', 'code') }}
      <h1>Software built around your business</h1>
      <p class="lead">An advanced POS, restaurant ordering, an AI receptionist, staff and inventory management — or something nobody sells, built exactly for the way you work.</p>
      {{ ui.contact(site, service='Software', label='Ask for pricing') }}
      <p class="page-hero__note">{{ ui.icon('tag') }}<span>Every system is priced per project. Call or message us for a clear quote.</span></p>
    </div>
    <div class="page-hero__media">
      {{ ui.wide('software-hero', 'Business software running on a point-of-sale terminal, tablet, laptop and phone') }}
    </div>
  </div>
</section>

<section class="section section--tight" id="systems">
  <div class="container">
    {% for item in software.flagship %}
    <article class="feature" id="{{ item.id }}">
      <div class="feature__media">
        {{ ui.img('software/' + item.id, item.name, '(min-width: 900px) 46vw, 94vw', loop.first) }}
        <span class="feature__badge">{{ item.badge }}</span>
      </div>
      <div class="feature__text">
        {{ ui.eyebrow(item.short, item.icon) }}
        <h2>{{ item.name }}</h2>
        <p class="feature__lead">{{ item.lead }}</p>
        <p>{{ item.text }}</p>
        <ul class="ticks ticks--two">
          {% for point in item.points -%}
          <li>{{ ui.icon('check') }}<span>{{ point }}</span></li>
          {%- endfor %}
        </ul>
        {{ ui.contact(site, service='Software', product=item.name, label='Ask for pricing', size='sm') }}
      </div>
    </article>
    {% endfor %}
  </div>
</section>

<section class="section section--soft" id="more">
  <div class="container">
    <header class="section-head">
      {{ ui.eyebrow('More we build', 'squares-four') }}
      <h2>Whatever your business runs on</h2>
      <p class="lead">These are the systems we’re asked for most. Each one is adapted to your business, your branding and the tools you already use.</p>
    </header>
    <div class="grid grid--3">
      {% for item in software.more -%}
      <article class="shot" id="{{ item.id }}">
        <div class="shot__media">{{ ui.img('software/' + item.id, item.name) }}</div>
        <div class="shot__body">
          <h3>{{ ui.icon(item.icon) }}{{ item.name }}</h3>
          <p>{{ item.text }}</p>
          <button class="link-button" type="button" data-quote data-service="Software" data-product="{{ item.name }}">Ask for pricing {{ ui.icon('arrow-right') }}</button>
        </div>
      </article>
      {%- endfor %}
    </div>
  </div>
</section>

<section class="section" id="also">
  <div class="container split">
    <div class="split__text">
      {{ ui.eyebrow('And much more', 'plus') }}
      <h2>If you can describe it, we can build it</h2>
      <p class="lead">Not on the list? That’s usually the point. Tell us the problem and we’ll design the simplest system that solves it.</p>
      <ul class="chips chips--lg">
        {% for item in software.also %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>
    <div class="split__text">
      <div class="split__media">{{ ui.img('software/custom-software', 'A developer’s desk with code and a custom business app on screen', '(min-width: 900px) 46vw, 94vw') }}</div>
      <h3>Industries we build for</h3>
      <ul class="chips chips--lg">
        {% for item in software.industries %}<li>{{ item }}</li>{% endfor %}
      </ul>
    </div>
  </div>
</section>

<section class="section section--soft" id="process">
  <div class="container">
    <header class="section-head section-head--center">
      {{ ui.eyebrow('How we work', 'lightning') }}
      <h2>No jargon. No surprises.</h2>
    </header>
    <ol class="steps steps--4">
      {% for step in software.steps -%}
      <li class="step"><div class="step__body"><h3>{{ step.title }}</h3><p>{{ step.text }}</p></div></li>
      {%- endfor %}
    </ol>
  </div>
</section>

<section class="section" id="faq">
  <div class="container">
    <header class="section-head section-head--center">
      {{ ui.eyebrow('Questions', 'question') }}
      <h2>Software questions, answered</h2>
    </header>
    {{ ui.faqs(software.faqs, true) }}
  </div>
</section>

{% set ctaTitle = 'Tell us what you need it to do' %}
{% set ctaText = 'Describe the problem in your own words. We’ll come back with ideas, a timeline and a clear price.' %}
{% set ctaService = 'Software' %}
{% set ctaLabel = 'Ask for pricing' %}
{% include "partials/cta.njk" %}
