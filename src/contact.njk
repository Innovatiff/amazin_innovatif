---
layout: layouts/base.njk
permalink: /contact.html
key: contact
accent: neutral
backdrop: aurora
title: Contact us — call, WhatsApp or send a message
eleventyComputed:
  description: "Get a quote for printing, a website, a booking system or custom software. Call, WhatsApp or send {{ site.name }} a message and we’ll get back to you."
---
{% import "ui.njk" as ui %}

<section class="page-hero">
  <div class="backdrop backdrop--aurora" aria-hidden="true"></div>
  <div class="container">
    <div class="page-hero__text">
      {{ ui.eyebrow('Contact', '👋') }}
      <h1>Let’s <span class="grad" data-accent="print">talk.</span></h1>
      <p class="lead">Tell us what you need — a print job, a website, a booking system or software — and we’ll come back with answers and a clear quote.</p>
    </div>
  </div>
</section>

<section class="section section--tight section--flush-top">
  <div class="container contact-grid">
    <div class="contact-methods">
      {% if site.phone -%}
      <a class="method" data-accent="web" href="{{ site.phone | tel }}">
        {{ ui.emojiTile('📞') }}
        <span><strong>Call us</strong><span>{{ site.phoneDisplay or site.phone }}</span></span>
        {{ ui.icon('caret-right') }}
      </a>
      {%- endif %}
      {% if site.whatsapp -%}
      <a class="method" data-accent="booking" href="{{ site.whatsapp | whatsapp('Hi ' + site.name + '! I’d like to ask about your services.') }}" target="_blank" rel="noopener">
        {{ ui.emojiTile('💬') }}
        <span><strong>WhatsApp</strong><span>Send photos, files and voice notes</span></span>
        {{ ui.icon('caret-right') }}
      </a>
      {%- endif %}
      <a class="method" data-accent="print" href="#message">
        {{ ui.emojiTile('✍️') }}
        <span><strong>Send a message</strong><span>Use the form and we’ll reply the way you prefer</span></span>
        {{ ui.icon('caret-right') }}
      </a>
      {% if site.email -%}
      <a class="method" data-accent="software" href="mailto:{{ site.email }}">
        {{ ui.emojiTile('✉️') }}
        <span><strong>Email</strong><span>{{ site.email }}</span></span>
        {{ ui.icon('caret-right') }}
      </a>
      {%- endif %}
      {% if site.address -%}
      <div class="method" data-accent="web">
        {{ ui.emojiTile('📍') }}
        <span><strong>Find us</strong><span>{{ site.address }}</span></span>
      </div>
      {%- endif %}
      {% if site.hours -%}
      <div class="method" data-accent="software">
        {{ ui.emojiTile('🕘') }}
        <span><strong>Opening hours</strong><span>{{ site.hours }}</span></span>
      </div>
      {%- endif %}
      <a class="method" data-accent="booking" href="/get-started">
        {{ ui.emojiTile('📅') }}
        <span><strong>Starting a booking system?</strong><span>Answer a few questions and reserve your spot</span></span>
        {{ ui.icon('caret-right') }}
      </a>
      {#- The photo fills the space beside the form. Once every contact detail
          is filled in, the list is already as tall as the form, so it is left out. -#}
      {% set details = (1 if site.phone else 0) + (1 if site.whatsapp else 0) + (1 if site.email else 0) + (1 if site.address else 0) + (1 if site.hours else 0) %}
      {% if details <= 3 -%}
      <figure>{{ ui.img('general/chat-support', 'A customer chatting with ' + site.name + ' about a print quote', '(min-width: 900px) 40vw, 94vw') }}</figure>
      {%- endif %}
    </div>

    <div class="panel" id="message">
      <h2>Send us a message</h2>
      <p>The more you tell us, the more accurate our first reply will be.</p>
      {% set formId = 'c' %}
      {% include "partials/lead-form.njk" %}
    </div>
  </div>
</section>

<section class="section" data-accent="web">
  <div class="container">
    <header class="section-head">
      <p class="eyebrow">What happens next</p>
      <h2>From message <span class="grad">to quote.</span></h2>
    </header>
    <ol class="steps steps--3">
      <li class="step"><div class="step__body"><h3>We read it properly</h3><p>Your message goes straight to our team — not into a queue of auto-replies.</p></div></li>
      <li class="step"><div class="step__body"><h3>We reply your way</h3><p>By call, WhatsApp or email — whichever you picked — with any questions we need answered.</p></div></li>
      <li class="step"><div class="step__body"><h3>You get a clear quote</h3><p>A price and a timeline in plain language, with no obligation to go ahead.</p></div></li>
    </ol>
  </div>
</section>
