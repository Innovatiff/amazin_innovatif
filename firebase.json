{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "hosting": {
    "public": "public",
    "predeploy": [
      "npm run build"
    ],
    "cleanUrls": true,
    "trailingSlash": false,
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      {
        "regex": "^/home(\\.html)?/?$",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "^/pricing(\\.html)?/?$",
        "destination": "/booking",
        "type": 301
      },
      {
        "regex": "^/web-marketing(\\.html)?/?$",
        "destination": "/booking",
        "type": 301
      },
      {
        "regex": "^/printed(\\.html)?/?$",
        "destination": "/printing",
        "type": 301
      },
      {
        "regex": "^/designs(\\.html)?/?$",
        "destination": "/printing",
        "type": 301
      },
      {
        "regex": "^/card(\\.html)?/?$",
        "destination": "/printing",
        "type": 301
      },
      {
        "regex": "^/website(\\.html)?/?$",
        "destination": "/websites",
        "type": 301
      },
      {
        "regex": "^/package(\\.html)?/?$",
        "destination": "/websites",
        "type": 301
      },
      {
        "regex": "^/plans(\\.html)?/?$",
        "destination": "/websites",
        "type": 301
      },
      {
        "regex": "^/assistants(\\.html)?/?$",
        "destination": "/contact",
        "type": 301
      },
      {
        "regex": "^/customers(\\.html)?/?$",
        "destination": "/",
        "type": 301
      },
      {
        "regex": "^/contact-sales(\\.html)?/?$",
        "destination": "/contact",
        "type": 301
      },
      {
        "regex": "^/contact-sales-send(\\.html)?/?$",
        "destination": "/contact",
        "type": 301
      }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "X-Frame-Options",
            "value": "DENY"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=()"
          },
          {
            "key": "Strict-Transport-Security",
            "value": "max-age=31536000"
          },
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://www.gstatic.com; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://*.googleapis.com http://127.0.0.1:8085 http://127.0.0.1:9099; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
          }
        ]
      },
      {
        "source": "/assets/img/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=2592000"
          }
        ]
      },
      {
        "source": "/assets/fonts/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      },
      {
        "source": "/assets/@(css|js)/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/assets/icons.svg",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=604800"
          }
        ]
      },
      {
        "source": "/portal",
        "headers": [
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-store"
          }
        ]
      },
      {
        "source": "/portal/designs",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://secure.helcim.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.netlify.app http://127.0.0.1:8085 http://127.0.0.1:9099 http://127.0.0.1:8787; frame-src https://secure.helcim.app https://*.helcim.app; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://secure.helcim.app\")"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/portal/designs/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://secure.helcim.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.netlify.app http://127.0.0.1:8085 http://127.0.0.1:9099 http://127.0.0.1:8787; frame-src https://secure.helcim.app https://*.helcim.app; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://secure.helcim.app\")"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/@(quote|checkout)/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://secure.helcim.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.netlify.app http://127.0.0.1:8085 http://127.0.0.1:9099 http://127.0.0.1:8787; frame-src https://secure.helcim.app https://*.helcim.app; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://secure.helcim.app\")"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/studio/**",
        "headers": [
          {
            "key": "Content-Security-Policy",
            "value": "default-src 'self'; script-src 'self' https://secure.helcim.app; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https:; font-src 'self'; connect-src 'self' https://*.googleapis.com https://*.netlify.app http://127.0.0.1:8085 http://127.0.0.1:9099 http://127.0.0.1:8787; frame-src https://secure.helcim.app https://*.helcim.app; form-action 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=(), payment=(self \"https://secure.helcim.app\")"
          },
          {
            "key": "X-Robots-Tag",
            "value": "noindex, nofollow"
          },
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/studio/assets/**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=31536000, immutable"
          }
        ]
      }
    ],
    "rewrites": [
      {
        "source": "/portal/designs",
        "destination": "/studio/index.html"
      },
      {
        "source": "/portal/designs/**",
        "destination": "/studio/index.html"
      },
      {
        "source": "/quote/**",
        "destination": "/studio/index.html"
      },
      {
        "source": "/checkout/**",
        "destination": "/studio/index.html"
      }
    ]
  },
  "emulators": {
    "auth": {
      "port": 9099
    },
    "firestore": {
      "port": 8085
    },
    "hosting": {
      "port": 5000
    },
    "ui": {
      "enabled": true,
      "port": 4000
    },
    "singleProjectMode": true
  }
}
